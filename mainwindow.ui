   <string notr="true">QMainWindow, QWidget#centralWidget { background-color: #1E1E2E; }
QLineEdit { background-color: #181825; color: #cdd6f4; font-size: 36px; border: none; border-radius: 10px; padding: 10px; qproperty-alignment: 'AlignRight | AlignVCenter'; }
QPushButton { background-color: #313244; color: #cdd6f4; border: none; border-radius: 10px; padding: 14px; margin: 2px; font-size: 18px; }
QPushButton:hover { background-color: #45475a; }
QPushButton:pressed { background-color: #585b70; }
QPushButton#btnClear, QPushButton#btnClearAll, QPushButton#btnDel { background-color: #453545; }
QPushButton#btnClear:hover, QPushButton#btnClearAll:hover, QPushButton#btnDel:hover { background-color: #5a455a; }
QPushButton#btnClear:pressed, QPushButton#btnClearAll:pressed, QPushButton#btnDel:pressed { background-color: #6e556e; }
QPushButton#btnPlus, QPushButton#btnMinus, QPushButton#btnMultiplied, QPushButton#btnDivision { background-color: #314b5a; }
QPushButton#btnPlus:hover, QPushButton#btnMinus:hover, QPushButton#btnMultiplied:hover, QPushButton#btnDivision:hover { background-color: #3d5d6e; }
QPushButton#btnPlus:pressed, QPushButton#btnMinus:pressed, QPushButton#btnMultiplied:pressed, QPushButton#btnDivision:pressed { background-color: #4a6f82; }
QPushButton#btnEquals { background-color: #2b4b3b; }
QPushButton#btnEquals:hover { background-color: #35604a; }
QPushButton#btnEquals:pressed { background-color: #3f7559; }</string>
